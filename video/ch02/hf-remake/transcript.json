[
  {
    "text": "大家好，",
    "start": 0.08,
    "end": 0.814,
    "id": "w0"
  },
  {
    "text": "这里是小电讲电路。",
    "start": 0.814,
    "end": 2.467,
    "id": "w1"
  },
  {
    "text": "驭者·Agent Har",
    "start": 2.467,
    "end": 4.67,
    "id": "w2"
  },
  {
    "text": "ness 第 02 讲。",
    "start": 4.67,
    "end": 6.873,
    "id": "w3"
  },
  {
    "text": "上一集我们说清楚：",
    "start": 6.873,
    "end": 8.525,
    "id": "w4"
  },
  {
    "text": "Harness 不是 A",
    "start": 8.525,
    "end": 10.729,
    "id": "w5"
  },
  {
    "text": "PI 套壳，",
    "start": 10.729,
    "end": 11.83,
    "id": "w6"
  },
  {
    "text": "是能跑、",
    "start": 11.83,
    "end": 12.565,
    "id": "w7"
  },
  {
    "text": "能停、",
    "start": 12.565,
    "end": 13.115,
    "id": "w8"
  },
  {
    "text": "能诊断的整车。",
    "start": 13.115,
    "end": 14.4,
    "id": "w9"
  },
  {
    "text": "这一集拆开发动机的点火节",
    "start": 14.4,
    "end": 16.604,
    "id": "w10"
  },
  {
    "text": "奏——对话主循环。",
    "start": 16.604,
    "end": 18.256,
    "id": "w11"
  },
  {
    "text": "书稿给它起了个名字：",
    "start": 18.416,
    "end": 20.109,
    "id": "w12"
  },
  {
    "text": "Agent 的心跳。",
    "start": 20.109,
    "end": 21.802,
    "id": "w13"
  },
  {
    "text": "先停三秒想一下：",
    "start": 21.802,
    "end": 23.156,
    "id": "w14"
  },
  {
    "text": "如果你在源码里找「心跳」，",
    "start": 23.156,
    "end": 25.356,
    "id": "w15"
  },
  {
    "text": "它最可能是什么？",
    "start": 25.356,
    "end": 26.711,
    "id": "w16"
  },
  {
    "text": "回调地图？",
    "start": 26.711,
    "end": 27.557,
    "id": "w17"
  },
  {
    "text": "Promise 链？",
    "start": 27.557,
    "end": 29.25,
    "id": "w18"
  },
  {
    "text": "还是一个 async f",
    "start": 29.25,
    "end": 31.281,
    "id": "w19"
  },
  {
    "text": "unction 星号？",
    "start": 31.281,
    "end": 33.143,
    "id": "w20"
  },
  {
    "text": "答案写在本章标题里——异",
    "start": 33.143,
    "end": 35.174,
    "id": "w21"
  },
  {
    "text": "步生成器 AsyncGe",
    "start": 35.174,
    "end": 37.206,
    "id": "w22"
  },
  {
    "text": "nerator。",
    "start": 37.206,
    "end": 38.56,
    "id": "w23"
  },
  {
    "text": "每一次 yield，",
    "start": 38.72,
    "end": 40.353,
    "id": "w24"
  },
  {
    "text": "就像一次脉搏：",
    "start": 40.353,
    "end": 41.496,
    "id": "w25"
  },
  {
    "text": "把「正在发生的事」推给 UI，",
    "start": 41.496,
    "end": 43.946,
    "id": "w26"
  },
  {
    "text": "而不是等整场手术做完才开门。",
    "start": 43.946,
    "end": 46.233,
    "id": "w27"
  },
  {
    "text": "书稿第二节开篇就说：",
    "start": 46.233,
    "end": 47.866,
    "id": "w28"
  },
  {
    "text": "Claude Code ",
    "start": 47.866,
    "end": 49.826,
    "id": "w29"
  },
  {
    "text": "的对话主循环，",
    "start": 49.826,
    "end": 50.969,
    "id": "w30"
  },
  {
    "text": "是一个由 async f",
    "start": 50.969,
    "end": 52.929,
    "id": "w31"
  },
  {
    "text": "unction 星号驱动",
    "start": 52.929,
    "end": 54.889,
    "id": "w32"
  },
  {
    "text": "的异步生成器。",
    "start": 54.889,
    "end": 56.032,
    "id": "w33"
  },
  {
    "text": "它不是普通函数跑完再返回，",
    "start": 56.192,
    "end": 58.502,
    "id": "w34"
  },
  {
    "text": "而是一条可暂停、",
    "start": 58.502,
    "end": 59.924,
    "id": "w35"
  },
  {
    "text": "可恢复、",
    "start": 59.924,
    "end": 60.635,
    "id": "w36"
  },
  {
    "text": "可取消的「心」。",
    "start": 60.635,
    "end": 62.057,
    "id": "w37"
  },
  {
    "text": "三层能力叠在一起。",
    "start": 62.057,
    "end": 63.656,
    "id": "w38"
  },
  {
    "text": "第一层，",
    "start": 63.656,
    "end": 64.367,
    "id": "w39"
  },
  {
    "text": "流式产出：",
    "start": 64.367,
    "end": 65.256,
    "id": "w40"
  },
  {
    "text": "每次 yield 推送一",
    "start": 65.256,
    "end": 67.389,
    "id": "w41"
  },
  {
    "text": "次结构化事件，",
    "start": 67.389,
    "end": 68.633,
    "id": "w42"
  },
  {
    "text": "UI 不用干等。",
    "start": 68.633,
    "end": 70.054,
    "id": "w43"
  },
  {
    "text": "第二层，",
    "start": 70.054,
    "end": 70.765,
    "id": "w44"
  },
  {
    "text": "取消语义：",
    "start": 70.765,
    "end": 71.654,
    "id": "w45"
  },
  {
    "text": "AbortSignal ",
    "start": 71.654,
    "end": 73.787,
    "id": "w46"
  },
  {
    "text": "或迭代器的 return",
    "start": 73.787,
    "end": 75.919,
    "id": "w47"
  },
  {
    "text": "，",
    "start": 75.919,
    "end": 76.097,
    "id": "w48"
  },
  {
    "text": "能走到 finally，",
    "start": 76.097,
    "end": 78.23,
    "id": "w49"
  },
  {
    "text": "把资源收干净——对应你按",
    "start": 78.23,
    "end": 80.362,
    "id": "w50"
  },
  {
    "text": " Ctrl+C。",
    "start": 80.362,
    "end": 81.784,
    "id": "w51"
  },
  {
    "text": "第三层，",
    "start": 81.944,
    "end": 82.825,
    "id": "w52"
  },
  {
    "text": "背压：",
    "start": 82.825,
    "end": 83.485,
    "id": "w53"
  },
  {
    "text": "消费者跟不上时，",
    "start": 83.485,
    "end": 85.247,
    "id": "w54"
  },
  {
    "text": "生成器自动暂停，",
    "start": 85.247,
    "end": 87.009,
    "id": "w55"
  },
  {
    "text": "事件不会在内存里无限堆。",
    "start": 87.009,
    "end": 89.651,
    "id": "w56"
  },
  {
    "text": "这三层，",
    "start": 89.651,
    "end": 90.532,
    "id": "w57"
  },
  {
    "text": "正好对应 Agent 真需求：",
    "start": 90.532,
    "end": 93.835,
    "id": "w58"
  },
  {
    "text": "边想边画、",
    "start": 93.835,
    "end": 94.936,
    "id": "w59"
  },
  {
    "text": "随时能停、",
    "start": 94.936,
    "end": 96.037,
    "id": "w60"
  },
  {
    "text": "工具狂奔时别把内存撑爆。",
    "start": 96.037,
    "end": 98.679,
    "id": "w61"
  },
  {
    "text": "为什么不选回调？",
    "start": 98.679,
    "end": 100.441,
    "id": "w62"
  },
  {
    "text": "回调会把逻辑撕碎在各个注册点。",
    "start": 100.441,
    "end": 103.744,
    "id": "w63"
  },
  {
    "text": "为什么不选 Promise 链？",
    "start": 103.904,
    "end": 106.528,
    "id": "w64"
  },
  {
    "text": "Promise 只能 r",
    "start": 106.528,
    "end": 108.496,
    "id": "w65"
  },
  {
    "text": "esolve 一次，",
    "start": 108.496,
    "end": 110.136,
    "id": "w66"
  },
  {
    "text": "装不下一路涌出的增量事件。",
    "start": 110.136,
    "end": 112.268,
    "id": "w67"
  },
  {
    "text": "Observable 很强，",
    "start": 112.268,
    "end": 114.564,
    "id": "w68"
  },
  {
    "text": "但学习与类型成本更高。",
    "start": 114.564,
    "end": 116.368,
    "id": "w69"
  },
  {
    "text": "AsyncGenerat",
    "start": 116.368,
    "end": 118.336,
    "id": "w70"
  },
  {
    "text": "or 刚刚好：",
    "start": 118.336,
    "end": 119.484,
    "id": "w71"
  },
  {
    "text": "原生语法、",
    "start": 119.484,
    "end": 120.304,
    "id": "w72"
  },
  {
    "text": "类型友好、",
    "start": 120.304,
    "end": 121.124,
    "id": "w73"
  },
  {
    "text": "取消路径清晰。",
    "start": 121.124,
    "end": 122.272,
    "id": "w74"
  },
  {
    "text": "函数签名本身就是契约。",
    "start": 122.432,
    "end": 124.627,
    "id": "w75"
  },
  {
    "text": "Yield 出来的是联合",
    "start": 124.627,
    "end": 127.022,
    "id": "w76"
  },
  {
    "text": "类型事件；",
    "start": 127.022,
    "end": 128.019,
    "id": "w77"
  },
  {
    "text": "真正的终局用 Termi",
    "start": 128.019,
    "end": 130.414,
    "id": "w78"
  },
  {
    "text": "nal 表达；",
    "start": 130.414,
    "end": 131.811,
    "id": "w79"
  },
  {
    "text": "参数则收成一个结构体——",
    "start": 131.811,
    "end": 134.205,
    "id": "w80"
  },
  {
    "text": "消息历史、",
    "start": 134.205,
    "end": 135.203,
    "id": "w81"
  },
  {
    "text": "系统提示、",
    "start": 135.203,
    "end": 136.201,
    "id": "w82"
  },
  {
    "text": "权限检查、",
    "start": 136.201,
    "end": 137.198,
    "id": "w83"
  },
  {
    "text": "工具执行上下文、",
    "start": 137.198,
    "end": 138.795,
    "id": "w84"
  },
  {
    "text": "压缩策略入口，",
    "start": 138.795,
    "end": 140.192,
    "id": "w85"
  },
  {
    "text": "都从这里进，",
    "start": 140.192,
    "end": 141.389,
    "id": "w86"
  },
  {
    "text": "不在散落的全局里偷拿。",
    "start": 141.389,
    "end": 143.584,
    "id": "w87"
  },
  {
    "text": "流式事件可以分成五类脉搏。",
    "start": 143.744,
    "end": 145.924,
    "id": "w88"
  },
  {
    "text": "stream_reque",
    "start": 145.924,
    "end": 147.935,
    "id": "w89"
  },
  {
    "text": "st_start：",
    "start": 147.935,
    "end": 149.444,
    "id": "w90"
  },
  {
    "text": "每次 API 将发未发，",
    "start": 149.444,
    "end": 151.456,
    "id": "w91"
  },
  {
    "text": "UI 可以亮「正在思考」。",
    "start": 151.456,
    "end": 153.636,
    "id": "w92"
  },
  {
    "text": "StreamEvent：",
    "start": 153.636,
    "end": 155.648,
    "id": "w93"
  },
  {
    "text": "Anthropic 原始流，",
    "start": 155.648,
    "end": 157.995,
    "id": "w94"
  },
  {
    "text": "文本增量、",
    "start": 157.995,
    "end": 158.833,
    "id": "w95"
  },
  {
    "text": "thinking、",
    "start": 158.833,
    "end": 160.342,
    "id": "w96"
  },
  {
    "text": "tool_use，",
    "start": 160.342,
    "end": 161.851,
    "id": "w97"
  },
  {
    "text": "像视频的每一帧。",
    "start": 161.851,
    "end": 163.192,
    "id": "w98"
  },
  {
    "text": "Message：",
    "start": 163.352,
    "end": 164.685,
    "id": "w99"
  },
  {
    "text": "结构化消息，",
    "start": 164.685,
    "end": 165.685,
    "id": "w100"
  },
  {
    "text": "助手、",
    "start": 165.685,
    "end": 166.185,
    "id": "w101"
  },
  {
    "text": "用户、",
    "start": 166.185,
    "end": 166.685,
    "id": "w102"
  },
  {
    "text": "系统，",
    "start": 166.685,
    "end": 167.185,
    "id": "w103"
  },
  {
    "text": "相当于剪辑好的镜头。",
    "start": 167.185,
    "end": 168.852,
    "id": "w104"
  },
  {
    "text": "TombstoneMes",
    "start": 168.852,
    "end": 170.852,
    "id": "w105"
  },
  {
    "text": "sage：",
    "start": 170.852,
    "end": 171.685,
    "id": "w106"
  },
  {
    "text": "流式回退时的墓碑，",
    "start": 171.685,
    "end": 173.185,
    "id": "w107"
  },
  {
    "text": "告诉 UI 某段历史作废。",
    "start": 173.185,
    "end": 175.352,
    "id": "w108"
  },
  {
    "text": "ToolUseSumma",
    "start": 175.352,
    "end": 177.352,
    "id": "w109"
  },
  {
    "text": "ryMessage：",
    "start": 177.352,
    "end": 179.019,
    "id": "w110"
  },
  {
    "text": "一批工具跑完后的折叠摘要，",
    "start": 179.019,
    "end": 181.185,
    "id": "w111"
  },
  {
    "text": "长会话才不至于被输出淹没。",
    "start": 181.185,
    "end": 183.352,
    "id": "w112"
  },
  {
    "text": "消息族谱也要心里有数。",
    "start": 183.512,
    "end": 185.332,
    "id": "w113"
  },
  {
    "text": "UserMessage ",
    "start": 185.332,
    "end": 187.318,
    "id": "w114"
  },
  {
    "text": "既是用户输入，",
    "start": 187.318,
    "end": 188.476,
    "id": "w115"
  },
  {
    "text": "也承载 tool_res",
    "start": 188.476,
    "end": 190.461,
    "id": "w116"
  },
  {
    "text": "ult——在 API 协",
    "start": 190.461,
    "end": 192.447,
    "id": "w117"
  },
  {
    "text": "议里工具结果必须以 us",
    "start": 192.447,
    "end": 194.432,
    "id": "w118"
  },
  {
    "text": "er 角色回灌，",
    "start": 194.432,
    "end": 195.756,
    "id": "w119"
  },
  {
    "text": "这是协议约束，",
    "start": 195.756,
    "end": 196.914,
    "id": "w120"
  },
  {
    "text": "不是命名任性。",
    "start": 196.914,
    "end": 198.072,
    "id": "w121"
  },
  {
    "text": "AssistantMes",
    "start": 198.072,
    "end": 200.058,
    "id": "w122"
  },
  {
    "text": "sage 可以同时带文本",
    "start": 200.058,
    "end": 202.043,
    "id": "w123"
  },
  {
    "text": "和 tool_use，",
    "start": 202.043,
    "end": 203.863,
    "id": "w124"
  },
  {
    "text": "边说边动手。",
    "start": 203.863,
    "end": 204.856,
    "id": "w125"
  },
  {
    "text": "SystemMessag",
    "start": 205.016,
    "end": 207.082,
    "id": "w126"
  },
  {
    "text": "e 不进 API，",
    "start": 207.082,
    "end": 208.632,
    "id": "w127"
  },
  {
    "text": "只做第四面墙。",
    "start": 208.632,
    "end": 209.837,
    "id": "w128"
  },
  {
    "text": "Attachment 与",
    "start": 209.837,
    "end": 211.903,
    "id": "w129"
  },
  {
    "text": " Progress 分别",
    "start": 211.903,
    "end": 213.969,
    "id": "w130"
  },
  {
    "text": "承载附件通知和工具进度。",
    "start": 213.969,
    "end": 216.035,
    "id": "w131"
  },
  {
    "text": "记住：",
    "start": 216.035,
    "end": 216.551,
    "id": "w132"
  },
  {
    "text": "事件是脉搏，",
    "start": 216.551,
    "end": 217.584,
    "id": "w133"
  },
  {
    "text": "消息是可归档的病历。",
    "start": 217.584,
    "end": 219.306,
    "id": "w134"
  },
  {
    "text": "什么叫一轮 Turn？",
    "start": 219.306,
    "end": 221.2,
    "id": "w135"
  },
  {
    "text": "从用户按下回车，",
    "start": 221.36,
    "end": 222.881,
    "id": "w136"
  },
  {
    "text": "到模型答完、",
    "start": 222.881,
    "end": 224.021,
    "id": "w137"
  },
  {
    "text": "可能调工具、",
    "start": 224.021,
    "end": 225.162,
    "id": "w138"
  },
  {
    "text": "再决定继续或收束——这就",
    "start": 225.162,
    "end": 227.443,
    "id": "w139"
  },
  {
    "text": "是一次心跳周期。",
    "start": 227.443,
    "end": 228.963,
    "id": "w140"
  },
  {
    "text": "书稿用医学比喻：",
    "start": 228.963,
    "end": 230.484,
    "id": "w141"
  },
  {
    "text": "模型是医生，",
    "start": 230.484,
    "end": 231.625,
    "id": "w142"
  },
  {
    "text": "先问诊再开检查，",
    "start": 231.625,
    "end": 233.145,
    "id": "w143"
  },
  {
    "text": "拿到化验单再复诊。",
    "start": 233.145,
    "end": 234.856,
    "id": "w144"
  },
  {
    "text": "queryLoop 是一",
    "start": 234.856,
    "end": 237.137,
    "id": "w145"
  },
  {
    "text": "个 while true",
    "start": 237.137,
    "end": 239.418,
    "id": "w146"
  },
  {
    "text": "。",
    "start": 239.418,
    "end": 239.608,
    "id": "w147"
  },
  {
    "text": "每一圈大致五阶段。",
    "start": 239.768,
    "end": 241.544,
    "id": "w148"
  },
  {
    "text": "阶段一，",
    "start": 241.544,
    "end": 242.333,
    "id": "w149"
  },
  {
    "text": "状态初始化：",
    "start": 242.333,
    "end": 243.517,
    "id": "w150"
  },
  {
    "text": "从上一拍的 State ",
    "start": 243.517,
    "end": 245.884,
    "id": "w151"
  },
  {
    "text": "解构只读视图，",
    "start": 245.884,
    "end": 247.265,
    "id": "w152"
  },
  {
    "text": "再准备本圈可写容器——读",
    "start": 247.265,
    "end": 249.633,
    "id": "w153"
  },
  {
    "text": "和写之间有清晰边界。",
    "start": 249.633,
    "end": 251.605,
    "id": "w154"
  },
  {
    "text": "阶段二，",
    "start": 251.605,
    "end": 252.395,
    "id": "w155"
  },
  {
    "text": "上下文预处理，",
    "start": 252.395,
    "end": 253.776,
    "id": "w156"
  },
  {
    "text": "七步管线。",
    "start": 253.776,
    "end": 254.762,
    "id": "w157"
  },
  {
    "text": "阶段三，",
    "start": 254.762,
    "end": 255.551,
    "id": "w158"
  },
  {
    "text": "注入的 callMode",
    "start": 255.551,
    "end": 257.919,
    "id": "w159"
  },
  {
    "text": "l 发起流式请求，",
    "start": 257.919,
    "end": 259.694,
    "id": "w160"
  },
  {
    "text": "边收边 yield，",
    "start": 259.694,
    "end": 261.667,
    "id": "w161"
  },
  {
    "text": "同时收集助手消息与工具块；",
    "start": 261.667,
    "end": 264.232,
    "id": "w162"
  },
  {
    "text": "若开启流式工具执行，",
    "start": 264.392,
    "end": 266.515,
    "id": "w163"
  },
  {
    "text": "甚至可以在响应未完成时先跑工具。",
    "start": 266.515,
    "end": 269.911,
    "id": "w164"
  },
  {
    "text": "阶段四，",
    "start": 269.911,
    "end": 270.76,
    "id": "w165"
  },
  {
    "text": "权限检查、",
    "start": 270.76,
    "end": 271.822,
    "id": "w166"
  },
  {
    "text": "并发分区、",
    "start": 271.822,
    "end": 272.883,
    "id": "w167"
  },
  {
    "text": "执行工具。",
    "start": 272.883,
    "end": 273.945,
    "id": "w168"
  },
  {
    "text": "阶段五，",
    "start": 273.945,
    "end": 274.794,
    "id": "w169"
  },
  {
    "text": "附件注入、",
    "start": 274.794,
    "end": 275.855,
    "id": "w170"
  },
  {
    "text": "打包新 State、",
    "start": 275.855,
    "end": 277.978,
    "id": "w171"
  },
  {
    "text": "continue 回阶段一。",
    "start": 277.978,
    "end": 280.95,
    "id": "w172"
  },
  {
    "text": "没有工具则走终止判定。",
    "start": 280.95,
    "end": 283.285,
    "id": "w173"
  },
  {
    "text": "七步预处理是上下文的「压力梯」，",
    "start": 283.285,
    "end": 286.681,
    "id": "w174"
  },
  {
    "text": "顺序刻意从轻到重。",
    "start": 286.681,
    "end": 288.592,
    "id": "w175"
  },
  {
    "text": "一，",
    "start": 288.752,
    "end": 289.137,
    "id": "w176"
  },
  {
    "text": "工具结果预算，",
    "start": 289.137,
    "end": 290.482,
    "id": "w177"
  },
  {
    "text": "超长输出先截断或外置。",
    "start": 290.482,
    "end": 292.597,
    "id": "w178"
  },
  {
    "text": "二，",
    "start": 292.597,
    "end": 292.982,
    "id": "w179"
  },
  {
    "text": "Snip，",
    "start": 292.982,
    "end": 293.943,
    "id": "w180"
  },
  {
    "text": "按消息级裁历史。",
    "start": 293.943,
    "end": 295.481,
    "id": "w181"
  },
  {
    "text": "三，",
    "start": 295.481,
    "end": 295.866,
    "id": "w182"
  },
  {
    "text": "Microcompact，",
    "start": 295.866,
    "end": 298.365,
    "id": "w183"
  },
  {
    "text": "缓存友好的轻量压缩，",
    "start": 298.365,
    "end": 300.288,
    "id": "w184"
  },
  {
    "text": "尽量别把 API 侧已缓",
    "start": 300.288,
    "end": 302.595,
    "id": "w185"
  },
  {
    "text": "存 token 整段作废",
    "start": 302.595,
    "end": 304.902,
    "id": "w186"
  },
  {
    "text": "。",
    "start": 304.902,
    "end": 305.095,
    "id": "w187"
  },
  {
    "text": "四，",
    "start": 305.095,
    "end": 305.479,
    "id": "w188"
  },
  {
    "text": "Context Coll",
    "start": 305.479,
    "end": 307.786,
    "id": "w189"
  },
  {
    "text": "apse，",
    "start": 307.786,
    "end": 308.748,
    "id": "w190"
  },
  {
    "text": "把一段对话收成更高密度的摘要图。",
    "start": 308.748,
    "end": 311.824,
    "id": "w191"
  },
  {
    "text": "五，",
    "start": 311.984,
    "end": 312.384,
    "id": "w192"
  },
  {
    "text": "系统提示组装，",
    "start": 312.384,
    "end": 313.783,
    "id": "w193"
  },
  {
    "text": "稳定前缀才能保住缓存命中。",
    "start": 313.783,
    "end": 316.382,
    "id": "w194"
  },
  {
    "text": "六，",
    "start": 316.382,
    "end": 316.782,
    "id": "w195"
  },
  {
    "text": "Autocompact，",
    "start": 316.782,
    "end": 319.181,
    "id": "w196"
  },
  {
    "text": "阈值触发的全量摘要，",
    "start": 319.181,
    "end": 321.18,
    "id": "w197"
  },
  {
    "text": "是重量级最后手段之一。",
    "start": 321.18,
    "end": 323.379,
    "id": "w198"
  },
  {
    "text": "七，",
    "start": 323.379,
    "end": 323.779,
    "id": "w199"
  },
  {
    "text": "Token 阻断检查，",
    "start": 323.779,
    "end": 325.978,
    "id": "w200"
  },
  {
    "text": "触硬顶就本地失败，",
    "start": 325.978,
    "end": 327.777,
    "id": "w201"
  },
  {
    "text": "别把注定失败的请求打出去。",
    "start": 327.777,
    "end": 330.376,
    "id": "w202"
  },
  {
    "text": "原则就一句：",
    "start": 330.536,
    "end": 331.84,
    "id": "w203"
  },
  {
    "text": "先付最小代价。",
    "start": 331.84,
    "end": 333.361,
    "id": "w204"
  },
  {
    "text": "马车意象也在这里：",
    "start": 333.361,
    "end": 335.317,
    "id": "w205"
  },
  {
    "text": "辔绳收得住，",
    "start": 335.317,
    "end": 336.621,
    "id": "w206"
  },
  {
    "text": "长途才跑得远。",
    "start": 336.621,
    "end": 338.143,
    "id": "w207"
  },
  {
    "text": "上下文窗口就是舆的载重；",
    "start": 338.143,
    "end": 340.751,
    "id": "w208"
  },
  {
    "text": "乱堆不压缩，",
    "start": 340.751,
    "end": 342.055,
    "id": "w209"
  },
  {
    "text": "车轴会断。",
    "start": 342.055,
    "end": 343.141,
    "id": "w210"
  },
  {
    "text": "终止不是含糊的 error。",
    "start": 343.141,
    "end": 346.184,
    "id": "w211"
  },
  {
    "text": "书稿列了十种原因：",
    "start": 346.184,
    "end": 348.14,
    "id": "w212"
  },
  {
    "text": "completed 正常完成；",
    "start": 348.14,
    "end": 351.4,
    "id": "w213"
  },
  {
    "text": "aborted_stre",
    "start": 351.56,
    "end": 353.543,
    "id": "w214"
  },
  {
    "text": "aming 与 abor",
    "start": 353.543,
    "end": 355.527,
    "id": "w215"
  },
  {
    "text": "ted_tools 对应",
    "start": 355.527,
    "end": 357.51,
    "id": "w216"
  },
  {
    "text": "用户在流式或工具期中断；",
    "start": 357.51,
    "end": 359.494,
    "id": "w217"
  },
  {
    "text": "max_turns、",
    "start": 359.494,
    "end": 361.147,
    "id": "w218"
  },
  {
    "text": "blocking_limit、",
    "start": 361.147,
    "end": 363.626,
    "id": "w219"
  },
  {
    "text": "prompt_too_long、",
    "start": 363.626,
    "end": 366.271,
    "id": "w220"
  },
  {
    "text": "model_error、",
    "start": 366.271,
    "end": 368.254,
    "id": "w221"
  },
  {
    "text": "stop_hook_pr",
    "start": 368.254,
    "end": 370.238,
    "id": "w222"
  },
  {
    "text": "evented、",
    "start": 370.238,
    "end": 371.56,
    "id": "w223"
  },
  {
    "text": "hook_stopped、",
    "start": 371.56,
    "end": 373.709,
    "id": "w224"
  },
  {
    "text": "image_error ",
    "start": 373.709,
    "end": 375.692,
    "id": "w225"
  },
  {
    "text": "覆盖循环上限、",
    "start": 375.692,
    "end": 376.849,
    "id": "w226"
  },
  {
    "text": "硬顶、",
    "start": 376.849,
    "end": 377.345,
    "id": "w227"
  },
  {
    "text": "恢复失败、",
    "start": 377.345,
    "end": 378.172,
    "id": "w228"
  },
  {
    "text": "API 异常、",
    "start": 378.172,
    "end": 379.329,
    "id": "w229"
  },
  {
    "text": "Hook 拦截与图片格式问题。",
    "start": 379.329,
    "end": 381.808,
    "id": "w230"
  },
  {
    "text": "细分终止，",
    "start": 381.968,
    "end": 382.781,
    "id": "w231"
  },
  {
    "text": "是为了调试时第一眼就知道",
    "start": 382.781,
    "end": 384.732,
    "id": "w232"
  },
  {
    "text": "「心跳停在哪」。",
    "start": 384.732,
    "end": 386.032,
    "id": "w233"
  },
  {
    "text": "主循环能测，",
    "start": 386.032,
    "end": 387.007,
    "id": "w234"
  },
  {
    "text": "是因为副作用被收进 Qu",
    "start": 387.007,
    "end": 388.958,
    "id": "w235"
  },
  {
    "text": "eryDeps。",
    "start": 388.958,
    "end": 390.259,
    "id": "w236"
  },
  {
    "text": "四个依赖特别关键：",
    "start": 390.259,
    "end": 391.722,
    "id": "w237"
  },
  {
    "text": "callModel、",
    "start": 391.722,
    "end": 393.347,
    "id": "w238"
  },
  {
    "text": "microcompact、",
    "start": 393.347,
    "end": 395.46,
    "id": "w239"
  },
  {
    "text": "autocompact、",
    "start": 395.46,
    "end": 397.411,
    "id": "w240"
  },
  {
    "text": "uuid。",
    "start": 397.411,
    "end": 398.224,
    "id": "w241"
  },
  {
    "text": "测试时塞假实现，",
    "start": 398.384,
    "end": 399.896,
    "id": "w242"
  },
  {
    "text": "不必在每个文件里 spy",
    "start": 399.896,
    "end": 402.165,
    "id": "w243"
  },
  {
    "text": "On 模块。",
    "start": 402.165,
    "end": 403.299,
    "id": "w244"
  },
  {
    "text": "书稿原话大意：",
    "start": 403.299,
    "end": 404.622,
    "id": "w245"
  },
  {
    "text": "今天光 callMode",
    "start": 404.622,
    "end": 406.891,
    "id": "w246"
  },
  {
    "text": "l 和 autocomp",
    "start": 406.891,
    "end": 409.16,
    "id": "w247"
  },
  {
    "text": "act，",
    "start": 409.16,
    "end": 409.916,
    "id": "w248"
  },
  {
    "text": "就在六到八个测试文件里重复样板。",
    "start": 409.916,
    "end": 412.94,
    "id": "w249"
  },
  {
    "text": "依赖注入把「和外部世界打",
    "start": 412.94,
    "end": 415.209,
    "id": "w250"
  },
  {
    "text": "交道」的边界钉死，",
    "start": 415.209,
    "end": 416.91,
    "id": "w251"
  },
  {
    "text": "循环内部才能专心做状态机。",
    "start": 416.91,
    "end": 419.368,
    "id": "w252"
  },
  {
    "text": "为什么坚持函数式生成器，",
    "start": 419.528,
    "end": 421.597,
    "id": "w253"
  },
  {
    "text": "而不是 class？",
    "start": 421.597,
    "end": 423.321,
    "id": "w254"
  },
  {
    "text": "每次对话一个新闭包，",
    "start": 423.321,
    "end": 425.046,
    "id": "w255"
  },
  {
    "text": "没有实例字段串味；",
    "start": 425.046,
    "end": 426.597,
    "id": "w256"
  },
  {
    "text": "yield 自带背压；",
    "start": 426.597,
    "end": 428.494,
    "id": "w257"
  },
  {
    "text": "return 走 fin",
    "start": 428.494,
    "end": 430.563,
    "id": "w258"
  },
  {
    "text": "ally；",
    "start": 430.563,
    "end": 431.425,
    "id": "w259"
  },
  {
    "text": "yield 星号把子循环",
    "start": 431.425,
    "end": 433.494,
    "id": "w260"
  },
  {
    "text": "的事件与终值一起委托上来",
    "start": 433.494,
    "end": 435.564,
    "id": "w261"
  },
  {
    "text": "。",
    "start": 435.564,
    "end": 435.736,
    "id": "w262"
  },
  {
    "text": "反模式警告写在这里：",
    "start": 435.896,
    "end": 438.052,
    "id": "w263"
  },
  {
    "text": "别把对话状态塞进全局变量",
    "start": 438.052,
    "end": 440.639,
    "id": "w264"
  },
  {
    "text": "或长寿命实例字段。",
    "start": 440.639,
    "end": 442.579,
    "id": "w265"
  },
  {
    "text": "全局杀并发测试，",
    "start": 442.579,
    "end": 444.303,
    "id": "w266"
  },
  {
    "text": "实例字段让多会话互相踩。",
    "start": 444.303,
    "end": 446.89,
    "id": "w267"
  },
  {
    "text": "闭包是最安全的舆厢。",
    "start": 446.89,
    "end": 449.046,
    "id": "w268"
  },
  {
    "text": "状态机三元模型：",
    "start": 449.046,
    "end": 450.77,
    "id": "w269"
  },
  {
    "text": "State、",
    "start": 450.77,
    "end": 452.064,
    "id": "w270"
  },
  {
    "text": "Continue、",
    "start": 452.064,
    "end": 454.004,
    "id": "w271"
  },
  {
    "text": "Terminal。",
    "start": 454.004,
    "end": 455.944,
    "id": "w272"
  },
  {
    "text": "State 可变但可控，",
    "start": 456.104,
    "end": 457.952,
    "id": "w273"
  },
  {
    "text": "每次 continue ",
    "start": 457.952,
    "end": 459.8,
    "id": "w274"
  },
  {
    "text": "造新对象，",
    "start": 459.8,
    "end": 460.571,
    "id": "w275"
  },
  {
    "text": "transition 字",
    "start": 460.571,
    "end": 462.419,
    "id": "w276"
  },
  {
    "text": "段记下「为什么继续」。",
    "start": 462.419,
    "end": 464.113,
    "id": "w277"
  },
  {
    "text": "Continue 是继续信号，",
    "start": 464.113,
    "end": 466.423,
    "id": "w278"
  },
  {
    "text": "带原因与附件。",
    "start": 466.423,
    "end": 467.501,
    "id": "w279"
  },
  {
    "text": "Terminal 是终止信号，",
    "start": 467.501,
    "end": 469.812,
    "id": "w280"
  },
  {
    "text": "带原因交还给调用方。",
    "start": 469.812,
    "end": 471.352,
    "id": "w281"
  },
  {
    "text": "类型系统逼你把路走清楚。",
    "start": 471.512,
    "end": 473.984,
    "id": "w282"
  },
  {
    "text": "七条 Continue ",
    "start": 473.984,
    "end": 476.455,
    "id": "w283"
  },
  {
    "text": "路径要能叫出名字。",
    "start": 476.455,
    "end": 478.309,
    "id": "w284"
  },
  {
    "text": "next_turn：",
    "start": 478.309,
    "end": 480.369,
    "id": "w285"
  },
  {
    "text": "工具跑完，",
    "start": 480.369,
    "end": 481.399,
    "id": "w286"
  },
  {
    "text": "历史扩展，",
    "start": 481.399,
    "end": 482.429,
    "id": "w287"
  },
  {
    "text": "最常见。",
    "start": 482.429,
    "end": 483.253,
    "id": "w288"
  },
  {
    "text": "max_output_t",
    "start": 483.253,
    "end": 485.725,
    "id": "w289"
  },
  {
    "text": "okens_escala",
    "start": 485.725,
    "end": 488.196,
    "id": "w290"
  },
  {
    "text": "te：",
    "start": 488.196,
    "end": 488.814,
    "id": "w291"
  },
  {
    "text": "首次截断先抬输出上限。",
    "start": 488.814,
    "end": 491.08,
    "id": "w292"
  },
  {
    "text": "max_output_t",
    "start": 491.24,
    "end": 493.537,
    "id": "w293"
  },
  {
    "text": "okens_recove",
    "start": 493.537,
    "end": 495.835,
    "id": "w294"
  },
  {
    "text": "ry：",
    "start": 495.835,
    "end": 496.409,
    "id": "w295"
  },
  {
    "text": "仍截断就注入恢复消息，",
    "start": 496.409,
