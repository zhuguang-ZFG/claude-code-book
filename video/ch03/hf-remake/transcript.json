[
  {
    "text": "大家好，",
    "start": 0.08,
    "end": 0.786,
    "id": "w0"
  },
  {
    "text": "这里是小电讲电路。",
    "start": 0.786,
    "end": 2.375,
    "id": "w1"
  },
  {
    "text": "驭者·Agent Har",
    "start": 2.375,
    "end": 4.494,
    "id": "w2"
  },
  {
    "text": "ness 第 03 讲。",
    "start": 4.494,
    "end": 6.613,
    "id": "w3"
  },
  {
    "text": "上一集心跳装上了：",
    "start": 6.613,
    "end": 8.202,
    "id": "w4"
  },
  {
    "text": "AsyncGenerat",
    "start": 8.202,
    "end": 10.321,
    "id": "w5"
  },
  {
    "text": "or 一下一下往外吐事件",
    "start": 10.321,
    "end": 12.44,
    "id": "w6"
  },
  {
    "text": "。",
    "start": 12.44,
    "end": 12.616,
    "id": "w7"
  },
  {
    "text": "心跳有了，",
    "start": 12.616,
    "end": 13.499,
    "id": "w8"
  },
  {
    "text": "还得有双手——否则马再壮，",
    "start": 13.499,
    "end": 15.794,
    "id": "w9"
  },
  {
    "text": "也够不着缰绳外的活。",
    "start": 15.794,
    "end": 17.56,
    "id": "w10"
  },
  {
    "text": "这一集拆工具系统。",
    "start": 17.72,
    "end": 19.396,
    "id": "w11"
  },
  {
    "text": "书稿标题写得很直白：",
    "start": 19.396,
    "end": 21.258,
    "id": "w12"
  },
  {
    "text": "Agent 的双手。",
    "start": 21.258,
    "end": 23.121,
    "id": "w13"
  },
  {
    "text": "先借一句马斯洛：",
    "start": 23.121,
    "end": 24.61,
    "id": "w14"
  },
  {
    "text": "如果你手里只有锤子，",
    "start": 24.61,
    "end": 26.473,
    "id": "w15"
  },
  {
    "text": "看什么都像钉子。",
    "start": 26.473,
    "end": 27.962,
    "id": "w16"
  },
  {
    "text": "换成 Agent：",
    "start": 27.962,
    "end": 29.638,
    "id": "w17"
  },
  {
    "text": "如果只有 Bash，",
    "start": 29.638,
    "end": 31.501,
    "id": "w18"
  },
  {
    "text": "读文件变成 cat，",
    "start": 31.501,
    "end": 33.363,
    "id": "w19"
  },
  {
    "text": "搜代码变成 grep，",
    "start": 33.363,
    "end": 35.411,
    "id": "w20"
  },
  {
    "text": "改文件变成 sed——能跑，",
    "start": 35.411,
    "end": 38.019,
    "id": "w21"
  },
  {
    "text": "但不叫工程。",
    "start": 38.019,
    "end": 39.136,
    "id": "w22"
  },
  {
    "text": "猜一猜：",
    "start": 39.296,
    "end": 39.997,
    "id": "w23"
  },
  {
    "text": "源码里「双手」最先钉住的，",
    "start": 39.997,
    "end": 42.277,
    "id": "w24"
  },
  {
    "text": "是五十多个函数名，",
    "start": 42.277,
    "end": 43.855,
    "id": "w25"
  },
  {
    "text": "还是一套叫五要素的协议？",
    "start": 43.855,
    "end": 45.959,
    "id": "w26"
  },
  {
    "text": "答案在本章骨架里——先协议，",
    "start": 45.959,
    "end": 48.414,
    "id": "w27"
  },
  {
    "text": "后清单；",
    "start": 48.414,
    "end": 49.115,
    "id": "w28"
  },
  {
    "text": "先 DNA，",
    "start": 49.115,
    "end": 50.167,
    "id": "w29"
  },
  {
    "text": "后肌肉。",
    "start": 50.167,
    "end": 50.869,
    "id": "w30"
  },
  {
    "text": "Claude Code ",
    "start": 50.869,
    "end": 52.973,
    "id": "w31"
  },
  {
    "text": "每个工具都走同一契约：",
    "start": 52.973,
    "end": 54.902,
    "id": "w32"
  },
  {
    "text": "Tool，",
    "start": 54.902,
    "end": 55.778,
    "id": "w33"
  },
  {
    "text": "三个泛型——Input、",
    "start": 55.778,
    "end": 57.882,
    "id": "w34"
  },
  {
    "text": "Output、",
    "start": 57.882,
    "end": 59.11,
    "id": "w35"
  },
  {
    "text": "Progress。",
    "start": 59.11,
    "end": 60.688,
    "id": "w36"
  },
  {
    "text": "输入用 Zod 钉成结构化对象；",
    "start": 60.848,
    "end": 64.412,
    "id": "w37"
  },
  {
    "text": "输出自由；",
    "start": 64.412,
    "end": 65.526,
    "id": "w38"
  },
  {
    "text": "进度单独开类型空间，",
    "start": 65.526,
    "end": 67.753,
    "id": "w39"
  },
  {
    "text": "好让执行中还能流式汇报。",
    "start": 67.753,
    "end": 70.426,
    "id": "w40"
  },
  {
    "text": "三者拆开，",
    "start": 70.426,
    "end": 71.54,
    "id": "w41"
  },
  {
    "text": "不是炫技，",
    "start": 71.54,
    "end": 72.654,
    "id": "w42"
  },
  {
    "text": "是让编译器分别检查三个关注点。",
    "start": 72.654,
    "end": 75.995,
    "id": "w43"
  },
  {
    "text": "五要素，",
    "start": 75.995,
    "end": 76.886,
    "id": "w44"
  },
  {
    "text": "就是双手的解剖。",
    "start": 76.886,
    "end": 78.668,
    "id": "w45"
  },
  {
    "text": "要素一，",
    "start": 78.668,
    "end": 79.559,
    "id": "w46"
  },
  {
    "text": "名称与别名。",
    "start": 79.559,
    "end": 80.896,
    "id": "w47"
  },
  {
    "text": "主名唯一；",
    "start": 81.056,
    "end": 81.951,
    "id": "w48"
  },
  {
    "text": "旧名靠别名继续命中。",
    "start": 81.951,
    "end": 83.741,
    "id": "w49"
  },
  {
    "text": "公开 API 里重命名是",
    "start": 83.741,
    "end": 85.888,
    "id": "w50"
  },
  {
    "text": "「只增不减」：",
    "start": 85.888,
    "end": 87.141,
    "id": "w51"
  },
  {
    "text": "SearchTool 改",
    "start": 87.141,
    "end": 89.289,
    "id": "w52"
  },
  {
    "text": "成 GrepTool，",
    "start": 89.289,
    "end": 91.257,
    "id": "w53"
  },
  {
    "text": "旧名仍得认得，",
    "start": 91.257,
    "end": 92.51,
    "id": "w54"
  },
  {
    "text": "否则配置、",
    "start": 92.51,
    "end": 93.405,
    "id": "w55"
  },
  {
    "text": "脚本、",
    "start": 93.405,
    "end": 93.942,
    "id": "w56"
  },
  {
    "text": "用户肌肉记忆一起断。",
    "start": 93.942,
    "end": 95.731,
    "id": "w57"
  },
  {
    "text": "要素二，",
    "start": 95.731,
    "end": 96.447,
    "id": "w58"
  },
  {
    "text": "Zod Schema。",
    "start": 96.447,
    "end": 98.416,
    "id": "w59"
  },
  {
    "text": "双重职责：",
    "start": 98.576,
    "end": 99.552,
    "id": "w60"
  },
  {
    "text": "运行时验证——别信 LL",
    "start": 99.552,
    "end": 101.895,
    "id": "w61"
  },
  {
    "text": "M 吐的参数；",
    "start": 101.895,
    "end": 103.261,
    "id": "w62"
  },
  {
    "text": "以及转成 JSON Sc",
    "start": 103.261,
    "end": 105.604,
    "id": "w63"
  },
  {
    "text": "hema 发给 API，",
    "start": 105.604,
    "end": 107.946,
    "id": "w64"
  },
  {
    "text": "当作工具说明书。",
    "start": 107.946,
    "end": 109.508,
    "id": "w65"
  },
  {
    "text": "describe 写清楚，",
    "start": 109.508,
    "end": 112.046,
    "id": "w66"
  },
  {
    "text": "模型才知道旋钮在哪。",
    "start": 112.046,
    "end": 113.998,
    "id": "w67"
  },
  {
    "text": "要素三，",
    "start": 113.998,
    "end": 114.779,
    "id": "w68"
  },
  {
    "text": "权限模型，",
    "start": 114.779,
    "end": 115.755,
    "id": "w69"
  },
  {
    "text": "三层叠。",
    "start": 115.755,
    "end": 116.536,
    "id": "w70"
  },
  {
    "text": "先 validateInput，",
    "start": 116.696,
    "end": 118.829,
    "id": "w71"
  },
  {
    "text": "管数据合不合法；",
    "start": 118.829,
    "end": 119.896,
    "id": "w72"
  },
  {
    "text": "再 hasPermiss",
    "start": 119.896,
    "end": 121.496,
    "id": "w73"
  },
  {
    "text": "ions 加 check",
    "start": 121.496,
    "end": 123.096,
    "id": "w74"
  },
  {
    "text": "Permissions，",
    "start": 123.096,
    "end": 124.696,
    "id": "w75"
  },
  {
    "text": "管该不该用；",
    "start": 124.696,
    "end": 125.496,
    "id": "w76"
  },
  {
    "text": "最后运行时属性，",
    "start": 125.496,
    "end": 126.563,
    "id": "w77"
  },
  {
    "text": "比如 isConcurr",
    "start": 126.563,
    "end": 128.163,
    "id": "w78"
  },
  {
    "text": "encySafe，",
    "start": 128.163,
    "end": 129.363,
    "id": "w79"
  },
  {
    "text": "影响后面能不能并行。",
    "start": 129.363,
    "end": 130.696,
    "id": "w80"
  },
  {
    "text": "数据合法性、",
    "start": 130.856,
    "end": 132.088,
    "id": "w81"
  },
  {
    "text": "权限策略、",
    "start": 132.088,
    "end": 133.114,
    "id": "w82"
  },
  {
    "text": "调度策略，",
    "start": 133.114,
    "end": 134.141,
    "id": "w83"
  },
  {
    "text": "各管各的，",
    "start": 134.141,
    "end": 135.168,
    "id": "w84"
  },
  {
    "text": "串起来才是护栏。",
    "start": 135.168,
    "end": 136.81,
    "id": "w85"
  },
  {
    "text": "要素四，",
    "start": 136.81,
    "end": 137.631,
    "id": "w86"
