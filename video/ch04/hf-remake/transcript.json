[
  {
    "text": "大家好，",
    "start": 0.08,
    "end": 0.878,
    "id": "w0"
  },
  {
    "text": "这里是小电讲电路。",
    "start": 0.878,
    "end": 2.673,
    "id": "w1"
  },
  {
    "text": "驭者·Agent Har",
    "start": 2.673,
    "end": 5.067,
    "id": "w2"
  },
  {
    "text": "ness 第 04 讲。",
    "start": 5.067,
    "end": 7.46,
    "id": "w3"
  },
  {
    "text": "上一集双手装上了：",
    "start": 7.46,
    "end": 9.256,
    "id": "w4"
  },
  {
    "text": "专工具、",
    "start": 9.256,
    "end": 10.054,
    "id": "w5"
  },
  {
    "text": "编排、",
    "start": 10.054,
    "end": 10.652,
    "id": "w6"
  },
  {
    "text": "流式执行。",
    "start": 10.652,
    "end": 11.649,
    "id": "w7"
  },
  {
    "text": "双手能伸多远，",
    "start": 11.649,
    "end": 13.046,
    "id": "w8"
  },
  {
    "text": "护栏说了算。",
    "start": 13.046,
    "end": 14.243,
    "id": "w9"
  },
  {
    "text": "这一集拆权限管线——Ag",
    "start": 14.243,
    "end": 16.636,
    "id": "w10"
  },
  {
    "text": "ent 的护栏。",
    "start": 16.636,
    "end": 18.232,
    "id": "w11"
  },
  {
    "text": "双手有了就能随便干？",
    "start": 18.392,
    "end": 20.58,
    "id": "w12"
  },
  {
    "text": "rm -rf、",
    "start": 20.58,
    "end": 22.112,
    "id": "w13"
  },
  {
    "text": "npm publish—",
    "start": 22.112,
    "end": 24.737,
    "id": "w14"
  },
  {
    "text": "—没有护栏就是裸奔。",
    "start": 24.737,
    "end": 26.925,
    "id": "w15"
  },
  {
    "text": "真护栏是啥？",
    "start": 26.925,
    "end": 28.238,
    "id": "w16"
  },
  {
    "text": "猜一猜：",
    "start": 28.238,
    "end": 29.113,
    "id": "w17"
  },
  {
    "text": "不是一扇大门，",
    "start": 29.113,
    "end": 30.645,
    "id": "w18"
  },
  {
    "text": "是四道闸。",
    "start": 30.645,
    "end": 31.739,
    "id": "w19"
  },
  {
    "text": "万能钥匙乱开，",
    "start": 31.739,
    "end": 33.271,
    "id": "w20"
  },
  {
    "text": "四道闸逐关落下。",
    "start": 33.271,
    "end": 35.021,
    "id": "w21"
  },
  {
    "text": "纵深防御，",
    "start": 35.021,
    "end": 36.115,
    "id": "w22"
  },
  {
    "text": "才叫大楼门禁，",
    "start": 36.115,
    "end": 37.647,
    "id": "w23"
  },
  {
    "text": "不叫门口一个保安。",
    "start": 37.647,
    "end": 39.616,
    "id": "w24"
  },
  {
    "text": "Claude Code ",
    "start": 39.776,
    "end": 41.868,
    "id": "w25"
  },
  {
    "text": "的权限检查不是一个布尔函",
    "start": 41.868,
    "end": 43.961,
    "id": "w26"
  },
  {
    "text": "数，",
    "start": 43.961,
    "end": 44.31,
    "id": "w27"
  },
  {
    "text": "而是四阶段管线。",
    "start": 44.31,
    "end": 45.705,
    "id": "w28"
  },
  {
    "text": "前一阶段做出终局决定，",
    "start": 45.705,
    "end": 47.623,
    "id": "w29"
  },
  {
    "text": "后面就短路不再跑。",
    "start": 47.623,
    "end": 49.192,
    "id": "w30"
  },
  {
    "text": "阶段一，",
    "start": 49.192,
    "end": 49.889,
    "id": "w31"
  },
  {
    "text": "validateInpu",
    "start": 49.889,
    "end": 51.982,
    "id": "w32"
  },
  {
    "text": "t——Zod Schem",
    "start": 51.982,
    "end": 54.074,
    "id": "w33"
  },
  {
    "text": "a 验证。",
    "start": 54.074,
    "end": 54.946,
    "id": "w34"
  },
  {
    "text": "先问数据合不合法，",
    "start": 54.946,
    "end": 56.515,
    "id": "w35"
  },
  {
    "text": "再问该不该用。",
    "start": 56.515,
    "end": 57.736,
    "id": "w36"
  },
  {
    "text": "缺 command 字段？",
    "start": 57.896,
    "end": 60.291,
    "id": "w37"
  },
  {
    "text": "解析失败。",
    "start": 60.291,
    "end": 61.212,
    "id": "w38"
  },
  {
    "text": "注意：",
    "start": 61.212,
    "end": 61.765,
    "id": "w39"
  },
  {
    "text": "失败不会硬崩，",
    "start": 61.765,
    "end": 63.054,
    "id": "w40"
  },
  {
    "text": "而是优雅降级成 ask，",
    "start": 63.054,
    "end": 65.265,
    "id": "w41"
  },
  {
    "text": "让用户决定要不要继续。",
    "start": 65.265,
    "end": 67.291,
    "id": "w42"
  },
  {
    "text": "安全系统里，",
    "start": 67.291,
    "end": 68.397,
    "id": "w43"
  },
  {
    "text": "错误处理要「安全」，",
    "start": 68.397,
    "end": 70.239,
    "id": "w44"
  },
  {
    "text": "不是只求「正确」。",
    "start": 70.239,
    "end": 71.897,
    "id": "w45"
  },
  {
    "text": "阶段二，",
    "start": 71.897,
    "end": 72.634,
    "id": "w46"
  },
  {
    "text": "规则匹配——deny 大",
    "start": 72.634,
    "end": 74.845,
    "id": "w47"
  },
  {
    "text": "于 ask 大于 all",
    "start": 74.845,
    "end": 77.055,
    "id": "w48"
  },
  {
    "text": "ow。",
    "start": 77.055,
    "end": 77.608,
    "id": "w49"
  },
  {
    "text": "铁律：",
    "start": 77.768,
    "end": 78.413,
    "id": "w50"
  },
  {
    "text": "显式拒绝压过显式允许。",
    "start": 78.413,
    "end": 80.778,
    "id": "w51"
  },
  {
    "text": "工具被整体 deny，",
    "start": 80.778,
    "end": 83.144,
    "id": "w52"
  },
  {
    "text": "立刻拒；",
    "start": 83.144,
    "end": 84.004,
    "id": "w53"
  },
  {
    "text": "ask 就强制确认；",
    "start": 84.004,
    "end": 86.154,
    "id": "w54"
  },
  {
    "text": "都没命中再看 allow。",
    "start": 86.154,
    "end": 88.949,
    "id": "w55"
  },
  {
    "text": "规则来源七层，",
    "start": 88.949,
    "end": 90.454,
    "id": "w56"
  },
  {
    "text": "就近原则：",
    "start": 90.454,
    "end": 91.529,
    "id": "w57"
  },
  {
    "text": "会话级压过命令行，",
    "start": 91.529,
    "end": 93.465,
    "id": "w58"
  },
  {
    "text": "命令行压过项目，",
    "start": 93.465,
    "end": 95.185,
    "id": "w59"
  },
  {
    "text": "项目压过全局用户。",
    "start": 95.185,
    "end": 97.12,
    "id": "w60"
  },
  {
    "text": "MCP 还能用服务器级通配，",
    "start": 97.28,
    "end": 99.687,
    "id": "w61"
  },
  {
    "text": "一把管住一整组工具。",
    "start": 99.687,
    "end": 101.406,
    "id": "w62"
  },
  {
    "text": "阶段三，",
    "start": 101.406,
    "end": 102.094,
    "id": "w63"
  },
  {
    "text": "checkPermiss",
    "start": 102.094,
    "end": 104.157,
    "id": "w64"
  },
  {
    "text": "ions——工具自己的上",
    "start": 104.157,
    "end": 106.22,
    "id": "w65"
  },
  {
    "text": "下文评估。",
    "start": 106.22,
    "end": 107.08,
    "id": "w66"
  },
  {
    "text": "Bash 会拆子命令、",
    "start": 107.08,
    "end": 108.971,
    "id": "w67"
  },
  {
    "text": "看路径、",
    "start": 108.971,
    "end": 109.659,
    "id": "w68"
  },
  {
    "text": "配前缀规则。",
    "start": 109.659,
    "end": 110.69,
    "id": "w69"
  },
  {
    "text": "返回四种行为：",
    "start": 110.69,
    "end": 111.894,
    "id": "w70"
  },
  {
    "text": "allow、",
    "start": 111.894,
    "end": 112.925,
    "id": "w71"
  },
  {
    "text": "deny、",
    "start": 112.925,
    "end": 113.785,
    "id": "w72"
  },
  {
    "text": "ask、",
    "start": 113.785,
    "end": 114.473,
    "id": "w73"
  },
  {
    "text": "passthrough。",
    "start": 114.473,
    "end": 116.536,
    "id": "w74"
  },
  {
    "text": "passthrough ",
    "start": 116.696,
    "end": 118.615,
    "id": "w75"
  },
  {
    "text": "是「我没意见，",
    "start": 118.615,
    "end": 119.735,
    "id": "w76"
  },
  {
    "text": "交给后面」；",
    "start": 119.735,
    "end": 120.694,
    "id": "w77"
  },
  {
    "text": "ask 是「我认为要确认」。",
    "start": 120.694,
    "end": 122.933,
    "id": "w78"
  },
  {
    "text": "后面 allow 规则能",
    "start": 122.933,
    "end": 124.852,
    "id": "w79"
  },
  {
    "text": "盖过 passthrou",
    "start": 124.852,
    "end": 126.771,
    "id": "w80"
  },
  {
    "text": "gh，",
    "start": 126.771,
    "end": 127.251,
    "id": "w81"
  },
  {
    "text": "盖不过明确的 ask。",
    "start": 127.251,
    "end": 129.01,
    "id": "w82"
  },
  {
    "text": "意图不同，",
    "start": 129.01,
    "end": 129.81,
    "id": "w83"
  },
  {
    "text": "结果不同。",
    "start": 129.81,
    "end": 130.609,
    "id": "w84"
  },
  {
    "text": "阶段四，",
    "start": 130.609,
    "end": 131.249,
    "id": "w85"
  },
  {
    "text": "交互式提示——人类授权。",
    "start": 131.249,
    "end": 133.168,
    "id": "w86"
  },
  {
    "text": "进入 ask 后，",
    "start": 133.328,
    "end": 134.98,
    "id": "w87"
  },
  {
    "text": "Hook、",
    "start": 134.98,
    "end": 135.897,
    "id": "w88"
  },
  {
    "text": "分类器、",
    "start": 135.897,
    "end": 136.631,
    "id": "w89"
  },
  {
    "text": "用户三路可能同时出手。",
    "start": 136.631,
    "end": 138.65,
    "id": "w90"
  },
  {
    "text": "ResolveOnce：",
    "start": 138.65,
    "end": 140.853,
    "id": "w91"
  },
  {
    "text": "先到先得，",
    "start": 140.853,
    "end": 141.77,
    "id": "w92"
  },
  {
    "text": "一张单程机票只能兑一次。",
    "start": 141.77,
    "end": 143.972,
    "id": "w93"
  },
  {
    "text": "Hook 信任最高，",
    "start": 143.972,
    "end": 145.808,
    "id": "w94"
  },
  {
    "text": "用户居中，",
    "start": 145.808,
    "end": 146.725,
    "id": "w95"
  },
  {
    "text": "分类器最低。",
    "start": 146.725,
    "end": 147.827,
    "id": "w96"
  },
  {
    "text": "企业里想少弹窗：",
    "start": 147.827,
    "end": 149.295,
    "id": "w97"
  },
  {
    "text": "预置 allow、",
    "start": 149.295,
    "end": 150.946,
    "id": "w98"
  },
  {
    "text": "开 auto、",
    "start": 150.946,
    "end": 152.231,
    "id": "w99"
  },
  {
    "text": "或写 Hook——三招可叠加。",
    "start": 152.231,
    "end": 154.984,
    "id": "w100"
  },
  {
    "text": "PermissionCo",
    "start": 155.144,
    "end": 157.387,
    "id": "w101"
  },
  {
    "text": "ntext 是权限系统的",
    "start": 157.387,
    "end": 159.63,
    "id": "w102"
  },
  {
    "text": "核心快照：",
    "start": 159.63,
    "end": 160.565,
    "id": "w103"
  },
  {
    "text": "模式、",
    "start": 160.565,
    "end": 161.125,
    "id": "w104"
  },
  {
    "text": "规则、",
    "start": 161.125,
    "end": 161.686,
    "id": "w105"
  },
  {
    "text": "额外工作目录、",
    "start": 161.686,
    "end": 162.994,
    "id": "w106"
  },
  {
    "text": "是否避免弹窗……字段全 ",
    "start": 162.994,
    "end": 165.237,
    "id": "w107"
  },
  {
    "text": "readonly。",
    "start": 165.237,
    "end": 166.92,
    "id": "w108"
  },
  {
    "text": "每次更新产生新对象，",
    "start": 166.92,
    "end": 168.789,
    "id": "w109"
  },
  {
    "text": "不改旧的。",
    "start": 168.789,
    "end": 169.723,
    "id": "w110"
  },
  {
    "text": "并发里两只手同时查权限，",
    "start": 169.723,
    "end": 171.966,
    "id": "w111"
  },
  {
    "text": "谁也不会踩到半截新半截旧",
    "start": 171.966,
    "end": 174.209,
    "id": "w112"
  },
  {
    "text": "的中间态。",
    "start": 174.209,
    "end": 175.144,
    "id": "w113"
  },
  {
    "text": "决策有三个来源：",
    "start": 175.304,
    "end": 176.647,
    "id": "w114"
  },
  {
    "text": "hook、",
    "start": 176.647,
    "end": 177.486,
    "id": "w115"
  },
  {
    "text": "user、",
    "start": 177.486,
    "end": 178.325,
    "id": "w116"
  },
  {
    "text": "classifier。",
    "start": 178.325,
    "end": 180.172,
    "id": "w117"
  },
  {
    "text": "hook 像管理员剧本，",
    "start": 180.172,
    "end": 182.186,
    "id": "w118"
  },
  {
    "text": "CI 里先判；",
    "start": 182.186,
    "end": 183.361,
    "id": "w119"
  },
  {
    "text": "user 是当面点允许或拒绝，",
    "start": 183.361,
    "end": 185.879,
    "id": "w120"
  },
  {
    "text": "还可选永久写入；",
    "start": 185.879,
    "end": 187.221,
    "id": "w121"
  },
  {
    "text": "classifier 是",
    "start": 187.221,
    "end": 189.236,
    "id": "w122"
  },
  {
    "text": " AI 监督 AI，",
    "start": 189.236,
    "end": 190.914,
    "id": "w123"
  },
  {
    "text": "信任最低，",
    "start": 190.914,
    "end": 191.753,
    "id": "w124"
  },
  {
    "text": "有些检查对它免疫。",
    "start": 191.753,
    "end": 193.264,
    "id": "w125"
  },
  {
    "text": "ResolveOnce ",
    "start": 193.424,
    "end": 195.341,
    "id": "w126"
  },
  {
    "text": "提供 resolve、",
    "start": 195.341,
    "end": 197.099,
    "id": "w127"
  },
  {
    "text": "isResolved、",
    "start": 197.099,
    "end": 198.857,
    "id": "w128"
  },
  {
    "text": "claim。",
    "start": 198.857,
    "end": 199.816,
    "id": "w129"
  },
  {
    "text": "单线程里 claim 就",
    "start": 199.816,
    "end": 201.733,
    "id": "w130"
  },
  {
    "text": "是轻量互斥：",
    "start": 201.733,
    "end": 202.692,
    "id": "w131"
  },
  {
    "text": "两个回调几乎同时到，",
    "start": 202.692,
    "end": 204.29,
    "id": "w132"
  },
  {
    "text": "也只有一个能兑票。",
    "start": 204.29,
    "end": 205.728,
    "id": "w133"
  },
  {
    "text": "跟第 02 章不可变状态",
    "start": 205.728,
    "end": 207.645,
    "id": "w134"
  },
  {
    "text": "流转一脉相承——状态要么",
    "start": 207.645,
    "end": 209.563,
    "id": "w135"
  },
  {
    "text": "旧要么新，",
    "start": 209.563,
    "end": 210.361,
    "id": "w136"
  },
  {
    "text": "没有一半一半。",
    "start": 210.361,
    "end": 211.48,
    "id": "w137"
  },
  {
    "text": "五种模式从严格到宽松：",
    "start": 211.64,
    "end": 213.296,
    "id": "w138"
  },
  {
    "text": "default、",
    "start": 213.296,
    "end": 214.5,
    "id": "w139"
  },
  {
    "text": "plan、",
    "start": 214.5,
    "end": 215.253,
    "id": "w140"
  },
  {
    "text": "auto、",
    "start": 215.253,
    "end": 216.006,
    "id": "w141"
  },
  {
    "text": "bypassPermis",
    "start": 216.006,
    "end": 217.812,
    "id": "w142"
  },
  {
    "text": "sions，",
    "start": 217.812,
    "end": 218.715,
    "id": "w143"
  },
  {
    "text": "外加内部的 bubble。",
    "start": 218.715,
    "end": 220.672,
    "id": "w144"
  },
  {
    "text": "default：",
    "start": 220.672,
    "end": 221.877,
    "id": "w145"
  },
  {
    "text": "逐次确认。",
    "start": 221.877,
    "end": 222.629,
    "id": "w146"
  },
  {
    "text": "除明确 allow 外，",
    "start": 222.629,
    "end": 224.436,
    "id": "w147"
  },
  {
    "text": "每次工具都问你。",
    "start": 224.436,
    "end": 225.64,
    "id": "w148"
  },
  {
    "text": "最安全，",
    "start": 225.8,
    "end": 226.567,
    "id": "w149"
  },
  {
    "text": "也最繁琐；",
