  "guides": {
    "deepseek-front": {
      "question": {
        "zh": "为什么研究代理内部的组合方式？"
      },
      "deliverable": {
        "zh": "选择无模型组件实验或完整 dsh 机制的阅读路线。"
      },
      "boundary": {
        "zh": "完整应用与真实模型未实跑。"
      },
      "plain": {
        "zh": "替换模块之前，需要先了解它提供什么能力，以及卸载时如何清理。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-front.b-opening"
      ]
    },
    "deepseek-ch01": {
      "question": {
        "zh": "已有 dsh 或尚未安装时，分别从哪里开始？"
      },
      "deliverable": {
        "zh": "确认完整应用的启动条件，按第 1.5 节运行组件实验。"
      },
      "boundary": {
        "zh": "组件检查已运行；完整 dsh 启动与准备脚本的在线流程未实跑。"
      },
      "plain": {
        "zh": "安装目录、工作目录和配置目录承担不同职责。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch01.b-opening"
      ]
    },
    "deepseek-ch02": {
      "question": {
        "zh": "依赖还没到齐时，插件会怎样？"
      },
      "deliverable": {
        "zh": "从计数器到审查插件，辨认服务、Context 与挂载 fiber。"
      },
      "boundary": {
        "zh": "服务隔离不等于操作系统沙箱。"
      },
      "plain": {
        "zh": "声明依赖后，服务的出现与消失都会影响插件。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch02.b-opening"
      ]
    },
    "deepseek-ch03": {
      "question": {
        "zh": "卸载插件后，还会留下哪些工作？"
      },
      "deliverable": {
        "zh": "理解 effect、父子所有权和异步清理。"
      },
      "boundary": {
        "zh": "资源清理不会回滚任意外部副作用。"
      },
      "plain": {
        "zh": "插件持有的监听器和连接，需要在卸载时一并清理。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch03.b-opening"
      ]
    },
    "deepseek-ch04": {
      "question": {
        "zh": "不同阶段的失败应该怎样恢复？"
      },
      "deliverable": {
        "zh": "区分缺依赖、初始化失败和事件错误。"
      },
      "boundary": {
        "zh": "配置行为以固定快照为准。"
      },
      "plain": {
        "zh": "缺依赖、配置错误和运行异常，需要不同的恢复方式。"
      },
      "sources": [
        "deepseek-repo"
      ],
      "plain_evidence": [
        "deepseek-ch04.b-opening"
      ]
    },
    "deepseek-ch05": {
      "question": {
        "zh": "替换循环需要保留哪些公共行为？"
      },
      "deliverable": {
        "zh": "沿工厂、句柄、发布与清理顺序阅读创建过程。"
      },
      "boundary": {
        "zh": "替代驱动是设计练习，未做完整集成。"
      },
      "plain": {
        "zh": "公共 Agent 接口与默认循环分开，替代驱动仍须承担原有契约。"
      },
      "sources": [
        "deepseek-repo"
