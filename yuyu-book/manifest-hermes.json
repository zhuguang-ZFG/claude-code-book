      "plain_evidence": [
        "hermes-ch05.b-opening"
      ],
      "sources": [
        "hermes-skills",
        "hermes-skills-tool"
      ]
    },
    "hermes-ch06": {
      "question": {
        "zh": "示例 URL 漏检后，究竟要改哪一份文件？"
      },
      "deliverable": {
        "zh": "开启示例扫描，查看 observation；若旧技能没有分类说明，再做局部修订。"
      },
      "boundary": {
        "zh": "一次任务的例外未必适合作为所有项目的规则。"
      },
      "plain": {
        "zh": "随书技能已包含修订后的方法。跟做时先改变项目规则，观察手头报告怎样变化。"
      },
      "plain_evidence": [
        "hermes-ch06.b-opening"
      ],
      "sources": [
        "hermes-skill-manage"
      ]
    },
    "hermes-ch07": {
      "question": {
        "zh": "上次为什么排除归档，后来又是谁改了范围？"
      },
      "deliverable": {
        "zh": "从检索片段继续读取邻近消息，核对时间与决定来源。"
      },
      "boundary": {
        "zh": "搜索结果只展示部分记录和内容窗口。"
      },
      "plain": {
        "zh": "历史可以解释旧决定，当前任务仍需读取现在的规则。"
      },
      "plain_evidence": [
        "hermes-ch07.b-opening"
      ],
      "sources": [
        "hermes-search",
        "hermes-state"
      ]
    },
    "hermes-ch08": {
      "question": {
        "zh": "旧记忆与新规则冲突时，怎样准确修订？"
      },
      "deliverable": {
        "zh": "定位唯一条目，比较删除前后的文件、快照和历史副本。"
      },
      "boundary": {
        "zh": "删除条目不会同时抹去历史、备份与当前上下文。"
      },
      "plain": {
        "zh": "先分辨规则变化与临时例外，再决定更新或删除哪条记忆。"
      },
      "plain_evidence": [
        "hermes-ch08.b-opening"
      ],
      "sources": [
        "hermes-memory",
        "hermes-memory-tool"
      ]
    },
    "hermes-ch09": {
      "question": {
        "zh": "资料清单工具怎样从插件目录进入一次调用？"
      },
      "deliverable": {
        "zh": "从两个完整插件文件读到注册入口，运行 9 项插件测试，再准备宿主配置。"
