  "guides": {
    "hermes-front": {
      "question": {
        "zh": "昨天已经交代过的项目要求，为什么今天还要再说？"
      },
      "deliverable": {
        "zh": "选定起步方式：先运行 Aurora，再逐步加入记忆、技能与插件。"
      },
      "boundary": {
        "zh": "本书运行了组件与本地文件流程，完整 Hermes 宿主尚未验证。"
      },
      "plain": {
        "zh": "先留一句规则入口，再保存检查方法，旧讨论则留在历史中；三者会在 Aurora 的变化中各自派上用场。"
      },
      "plain_evidence": [
        "hermes-front.b-opening"
      ],
      "sources": [
        "hermes-repo"
      ]
    },
    "hermes-ch01": {
      "question": {
        "zh": "还没安装 Hermes，怎样先做出第一份 Aurora 报告？"
      },
      "deliverable": {
        "zh": "建立 Aurora，打开规则和报告；已安装 Hermes 时，再准备独立 home。"
      },
      "boundary": {
        "zh": "切换工作目录不会自动切换用户配置。"
      },
      "plain": {
        "zh": "本书仓库放程序，Aurora 目录放资料与报告，Hermes home 放助手配置和历史。"
      },
      "plain_evidence": [
        "hermes-ch01.b-opening"
      ],
      "sources": [
        "hermes-repo",
        "hermes-config"
      ]
    },
    "hermes-ch02": {
      "question": {
        "zh": "“检查 Aurora”怎样变成一次具体工具调用？"
      },
      "deliverable": {
        "zh": "追踪工具名、参数、退出码与送回模型的结果。"
      },
      "boundary": {
        "zh": "参数符合 schema，仍可能不符合业务规则。"
      },
      "plain": {
        "zh": "模型提出读取或执行请求，Hermes 调用工具，再把结果送回对话。"
      },
      "plain_evidence": [
        "hermes-ch02.b-opening"
      ],
      "sources": [
        "hermes-loop",
        "hermes-registry"
      ]
    },
    "hermes-ch03": {
      "question": {
        "zh": "会话恢复了，文件已经改名，接下来怎么办？"
      },
      "deliverable": {
        "zh": "把 setup.md 改名为 install.md，再修复索引，并保留这个新状态继续跟做。"
      },
      "boundary": {
        "zh": "重新打开会话记录不会撤销文件变化。"
      },
      "plain": {
        "zh": "恢复对话后重新读取项目，判断旧计划还适不适用。"
      },
      "plain_evidence": [
        "hermes-ch03.b-opening"
      ],
      "sources": [
        "hermes-state",
        "hermes-loop",
        "hermes-compression"
      ]
    },
    "hermes-ch04": {
      "question": {
        "zh": "文件已经写入新记忆，为什么加载时的提示快照还没变？"
      },
      "deliverable": {
        "zh": "用隔离的组件实验比较磁盘、对象条目与提示快照，再读审批和批处理路径。"
      },
      "boundary": {
        "zh": "当前提示快照可能仍保留加载时的旧内容。"
      },
      "plain": {
        "zh": "提示快照是加载时保存的记忆文字；Aurora 报告中的 snapshot 则记录检查过的文件，两者用途不同。"
      },
      "plain_evidence": [
        "hermes-ch04.b-opening"
      ],
      "sources": [
        "hermes-memory",
        "hermes-memory-tool",
        "hermes-atomic"
      ]
    },
    "hermes-ch05": {
      "question": {
        "zh": "怎样把 Aurora 检查步骤写成可复用的技能？"
      },
      "deliverable": {
        "zh": "打开完整 aurora-review，确认技能、检查器与项目规则各放在哪里。"
      },
      "boundary": {
        "zh": "读取技能正文不会自动执行其中的脚本。"
      },
      "plain": {
        "zh": "复制技能只带走方法，检查器仍在本书仓库；调用时要知道程序与资料各自的位置。"
