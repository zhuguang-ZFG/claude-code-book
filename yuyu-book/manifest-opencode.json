    "opencode-ch01": {
      "question": {
        "zh": "如何确认第一次任务真正读到了目标文件？"
      },
      "deliverable": {
        "zh": "先确认版本并运行随书驱动，再对照配置与文件读取结果。"
      },
      "boundary": {
        "zh": "本地模型替身驱动；不测真实模型效果。"
      },
      "plain": {
        "zh": "固定版本和目录，用一个文件读取任务跑通宿主。"
