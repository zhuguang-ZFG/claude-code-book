      "question": {
        "zh": "控制平面和 harness 的差别在哪里？"
      },
      "deliverable": {
        "zh": "用一张 ownership 图定位 server、provider 与客户端。"
      },
      "boundary": {
        "zh": "只依据固定提交的官方文档，不推断未写明的实现。"
      },
      "plain": {
        "zh": "T3 Code 管线程与权限，不取代真正干活的 agent。"
      },
      "plain_evidence": [
        "t3code-front.b-opening"
      ],
      "sources": [
        "t3code-source"
      ]
    },
